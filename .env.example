# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------

# Signs the app's access and refresh tokens (HS256). At least 32 characters: openssl rand -hex 32
JWT_SECRET_KEY=

# Postgres password for docker compose (db service and the api's DATABASE_URL).
# Must be URL-safe (letters, digits, - _ . ~): openssl rand -hex 24
POSTGRES_PASSWORD=

# Used when running the app or scripts outside docker compose (compose sets its own, pointing at the db service).
DATABASE_URL=postgresql://autocare:<password>@localhost:5432/autocare

DEEPSEEK_API_KEY=

# --- Optional (defaults shown) ------------------------------------------------

# Comma-separated Google OAuth client ids (Web/Android/iOS). Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=

# Address(es) of the reverse proxy whose X-Forwarded-For uvicorn trusts (IPs or CIDR, comma-separated).
FORWARDED_ALLOW_IPS=127.0.0.1

ENV=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Brave Search API key: finds manual PDFs on more sites than startmycar (and reference photos for car artwork).
BRAVE_API_KEY=
MANUAL_MAX_SOURCES=3
MANUAL_MAX_MB=80

WHISPER_MODEL=small
CLAP_MODEL=laion/clap-htsat-unfused
SOUND_MIN_SCORE=0.2

MAX_FRAMES=8
MAX_MEDIA_SECONDS=60
MAX_MEDIA_MB=100
MAX_IMAGES=4
MAX_IMAGE_MB=10

KB_TOP_K=8
HISTORY_MESSAGES=10

# Uploaded originals; the compose file mounts the media volume here.
MEDIA_DIR=/data/media
# Uploads are refused while the media volume has less free space than this.
MEDIA_MIN_FREE_MB=2048

# Per-user cap on stored media originals in MB; 0 turns it off
MEDIA_USER_QUOTA_MB=500

# Abuse protection (see README)
# Sign-up needs this code in the register body field invite_code; empty leaves registration open. Set it on a public deployment.
REGISTRATION_CODE=
# Serve /docs, /redoc and /openapi.json.
ENABLE_DOCS=false
# Messages per account per UTC day; 0 turns the cap off.
DAILY_MESSAGE_LIMIT=200
# Turns with attachments running at once in the process; 0 turns the ceiling off.
MAX_CONCURRENT_MEDIA_TURNS=2

# Vehicle visuals
# PUBLIC_BASE_URL must be the public https origin; empty disables signed artwork urls.
VISUALS_DIR=/data/visuals
PUBLIC_BASE_URL=
VISUAL_URL_TTL_SECONDS=900
VISUAL_PREPARE_PER_HOUR=20
VISUAL_JOBS_PER_HOUR=60
VISUAL_POLL_SECONDS=10
VISUAL_PROVIDER_ENABLED=false
VISUAL_PROVIDER_DAILY_BUDGET=20
VISUAL_CURATED_DIR=/data/visuals/curated
