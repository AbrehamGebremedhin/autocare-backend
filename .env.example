# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# At least 32 characters; signs the app's own access/refresh tokens.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Supabase dashboard > Project Settings > API.
SUPABASE_URL=
# Must be the SERVICE ROLE key (not the anon key): the schema turns row-level
# security on with no policies, so the anon key can read nothing.
SUPABASE_KEY=

# https://platform.deepseek.com > API keys
DEEPSEEK_API_KEY=

# --- Optional (defaults shown) ----------------------------------------------
ENV=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

WHISPER_MODEL=small
CLAP_MODEL=laion/clap-htsat-unfused
SOUND_MIN_SCORE=0.2

MAX_FRAMES=8
MAX_MEDIA_SECONDS=60
MAX_MEDIA_MB=100
MAX_IMAGES=4
MAX_IMAGE_MB=10

KB_TOP_K=8
HISTORY_MESSAGES=10
