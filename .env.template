# AutoCare Backend - Concurrent Configuration Template
# Copy this file to .env and update with your actual values

# ===============================
# APPLICATION SETTINGS
# ===============================
APP_NAME="AutoCare API - Concurrent Edition"
DEBUG=false
ENV=production
VERSION=2.0.0

# ===============================
# SECURITY SETTINGS
# ===============================
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-at-least-32-characters-long
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com,https://app.yourdomain.com

# ===============================
# DATABASE SETTINGS
# ===============================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_PASSWORD=your-supabase-password

# Enhanced Database Connection Pool Settings
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=100
DB_POOL_MAX_IDLE_TIME=3600
DB_POOL_MAX_USES=1000
DB_CONNECTION_TIMEOUT=30

# ===============================
# REDIS SETTINGS
# ===============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_SOCKET_TIMEOUT=5

# ===============================
# MILVUS VECTOR DATABASE
# ===============================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===============================
# SESSION MANAGEMENT
# ===============================
MAX_CONCURRENT_SESSIONS=10000
MAX_SESSIONS_PER_USER=5
SESSION_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL=3600

# ===============================
# WEBSOCKET SETTINGS
# ===============================
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_CONNECTION_TIMEOUT=3600

# ===============================
# AGENT POOL SETTINGS
# ===============================
AGENT_POOL_SIZE=50

# Orchestrator Agents
ORCHESTRATOR_AGENTS_MIN=2
ORCHESTRATOR_AGENTS_MAX=10

# Symptom Extractor Agents
SYMPTOM_AGENTS_MIN=3
SYMPTOM_AGENTS_MAX=15

# Diagnostic Agents
DIAGNOSTIC_AGENTS_MIN=3
DIAGNOSTIC_AGENTS_MAX=15

# User Interaction Agents
USER_INTERACTION_AGENTS_MIN=2
USER_INTERACTION_AGENTS_MAX=10

# ===============================
# RATE LIMITING
# ===============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=2000
RATE_LIMIT_BURST_THRESHOLD=50
ADAPTIVE_RATE_LIMITING=true

# ===============================
# CACHING SETTINGS
# ===============================
CACHE_TTL_SECONDS=3600
LOCAL_CACHE_TTL_SECONDS=300
CONVERSATION_CACHE_SIZE=1000

# ===============================
# PERFORMANCE SETTINGS
# ===============================
MAX_CONCURRENT_REQUESTS=1000
REQUEST_TIMEOUT=300
BACKGROUND_TASK_WORKERS=4

# ===============================
# LLM API SETTINGS
# ===============================
GEMINI_KEY=your-google-gemini-api-key
GEMINI_MODEL_1=gemini-pro
GEMINI_MODEL_2=gemini-pro-vision

# Optional DeepSeek AI
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ===============================
# EXTERNAL API SETTINGS
# ===============================
YOUTUBE_API_KEY=your-youtube-api-key
BASE_URL=https://api.yourdomain.com/

# ===============================
# MONITORING & LOGGING
# ===============================
LOG_LEVEL=INFO
ENABLE_METRICS=true
METRICS_PORT=9090

# ===============================
# SECURITY FEATURES
# ===============================
SECURITY_HEADERS_ENABLED=true
AUDIT_LOGGING_ENABLED=true
CORS_MAX_AGE=3600

# ===============================
# HORIZONTAL SCALING (Optional)
# ===============================
ENABLE_HORIZONTAL_SCALING=false
SERVICE_DISCOVERY_ENABLED=false
LOAD_BALANCER_ENABLED=false

# ===============================
# PRODUCTION SPECIFIC
# ===============================
# Set these based on your deployment requirements

# For Docker Compose deployment
COMPOSE_PROJECT_NAME=autocare-backend

# For container orchestration
REPLICAS=3
RESTART_POLICY=unless-stopped

# Health check settings
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Resource limits (adjust based on your server capacity)
MEMORY_LIMIT=2g
CPU_LIMIT=1
MEMORY_RESERVATION=1g
CPU_RESERVATION=0.5

# Logging configuration
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Network settings
NETWORK_NAME=autocare-network
SUBNET=172.20.0.0/16

# Volume settings
DATA_VOLUME=autocare-data
LOGS_VOLUME=autocare-logs
CACHE_VOLUME=autocare-cache

# SSL/TLS (if using reverse proxy)
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/autocare.crt
SSL_KEY_PATH=/etc/ssl/private/autocare.key

# Backup settings
BACKUP_ENABLED=true
BACKUP_INTERVAL=daily
BACKUP_RETENTION_DAYS=30

# ===============================
# DEVELOPMENT OVERRIDES
# ===============================
# Uncomment these for development environment
# DEBUG=true
# ENV=development
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10
# MAX_CONCURRENT_SESSIONS=100
# RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# ===============================
# STAGING OVERRIDES
# ===============================
# Uncomment these for staging environment
# ENV=staging
# DEBUG=false
# DB_POOL_MIN_SIZE=5
# DB_POOL_MAX_SIZE=25
# MAX_CONCURRENT_SESSIONS=1000
