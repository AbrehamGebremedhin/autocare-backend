# AutoCare Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ================================
# Application Settings
# ================================
APP_NAME=AutoCare API
ENV=development  # development, staging, production
DEBUG=true

# ================================
# Security Settings
# ================================
# IMPORTANT: Change this in production to a secure random string (min 32 chars)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# ================================
# Database Settings (Supabase)
# ================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_PASSWORD=your-supabase-password

# ================================
# External APIs
# ================================
# Google Gemini AI
GEMINI_KEY=your-gemini-api-key
GEMINI_MODEL_1=gemini-pro
GEMINI_MODEL_2=gemini-pro-vision

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key

# ================================
# Services Configuration
# ================================
# Milvus Vector Database
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# WebSocket Configuration
WEBSOCKET_URL=ws://localhost:8080

# Application Base URL
BASE_URL=https://autocare.yourdomain.com/

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ================================
# Security Features
# ================================
SECURITY_HEADERS_ENABLED=true
AUDIT_LOGGING_ENABLED=true

# ================================
# Docker/Container Settings
# ================================
# When running in Docker, use these for external services
# MILVUS_HOST=host.docker.internal
# REDIS_HOST=host.docker.internal
# OLLAMA_HOST=host.docker.internal
