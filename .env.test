# Test Environment Configuration
# DO NOT USE IN PRODUCTION

# JWT Configuration (32+ characters required)
JWT_SECRET_KEY=test-jwt-secret-key-for-unit-tests-must-be-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRATION_TIME=3600

# Database Configuration
DATABASE_URL=sqlite:///./test_autocare.db
SUPABASE_URL=https://test-supabase-url.supabase.co
SUPABASE_KEY=test-supabase-key-for-testing-purposes-only

# Redis Configuration  
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=
REDIS_DB=1

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=AutoCare Backend Test
DEBUG=true
TESTING=true

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
SECRET_KEY=test-secret-key-for-testing-purposes-minimum-32-characters

# External APIs (test keys)
OPENAI_API_KEY=sk-test-openai-api-key-for-testing
ANTHROPIC_API_KEY=sk-ant-test-anthropic-api-key-for-testing

# Logging
LOG_LEVEL=DEBUG

# Rate Limiting  
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# Environment
ENVIRONMENT=test
